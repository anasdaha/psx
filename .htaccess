# Keep config and the cache folder private (Apache / LiteSpeed shared hosting).
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
RedirectMatch 403 /cache/
<IfModule mod_headers.c>
  # data.json and the history/ files change on every sync
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
